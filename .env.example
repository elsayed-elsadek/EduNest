# ---------------------------------------------------------------------------
# EduNest frontend — public environment variables
# ---------------------------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to the browser, and their
# values are inlined into the bundle at build time.
#
# NEVER put passwords, private API keys or any other secret in this file.
# ---------------------------------------------------------------------------

# Absolute base URL of the EduNest backend (including the http/https scheme,
# without a trailing slash).
#
#   Development: http://localhost:8080
#   Staging:     https://api.staging.example.com
#   Production:  https://api.example.com   (required in production builds)
#
# Missing in development  -> falls back to http://localhost:8080
# Missing in production   -> the app fails fast with a clear [env] error
# Non-absolute value      -> rejected (e.g. "staging.example.com")
# localhost in production -> rejected
VITE_API_BASE_URL=https://api.example.com
